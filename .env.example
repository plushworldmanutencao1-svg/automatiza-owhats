# Configurações da Automatização WhatsApp

# Pasta de entrada para arquivos TXT
INPUT_DIR=./data/input

# Pasta de saída para planilhas
OUTPUT_DIR=./data/output

# Formato padrão de saída (excel, csv, both)
DEFAULT_FORMAT=excel

# Aplicar formatação no Excel?
APPLY_FORMATTING=true

# Integração com o Sistema de Gruas (sincronizar dados automaticamente)
# URL onde o sistema de gruas está publicado (sem barra no final)
SISTEMA_GRUAS_API_URL=https://seu-sistema-gruas.vercel.app
# Mesma chave configurada em WHATSAPP_IMPORT_API_KEY no sistema de gruas
SISTEMA_GRUAS_API_KEY=
